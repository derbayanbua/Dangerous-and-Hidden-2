; Engine configuration file.
; Dangerous Hidden 2 - Godot 4.7

config_version=5

[application]

config/name="Dangerous Hidden 2"
config/description="Taktischer WW2-Squad-Shooter (eigenständige Neuentwicklung)"
config/version="0.7.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
Settings="*res://src/autoload/settings.gd"
InputSetup="*res://src/autoload/input_setup.gd"
Game="*res://src/autoload/game.gd"
Effects="*res://src/combat/effects.gd"
Ballistics="*res://src/combat/ballistics.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/vsync/vsync_mode=1

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="characters"
3d_physics/layer_3="hitboxes"
3d_physics/layer_4="interactables"
3d_physics/layer_5="fences"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.2

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.3, 0.33, 0.36, 1)
